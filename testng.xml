<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="All Test Suite" parallel="none" thread-count="2">

    <!-- ============================
         TESTNG LISTENERS (Allure + Extent)
         ============================ -->
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
<!--        <listener class-name="testUtils.ExtendListenerClass"/>-->
    </listeners>


    <!-- ============================
         SINGLE TEST (Sequential Execution)
         ============================ -->
    <test name="Complete Test Execution">
        <parameter name="Browser" value="chrome"/>
        <classes>
            <class name="TestClasses.SettingTabTest"/>
        </classes>
    </test>
</suite>